# Jenkins Pipeline .gitignore

# Jenkins specific files
jenkins.log
jenkins.log.*
*.hpi
*.jpi
work/
secrets/
fingerprints/
identity.key.enc

# Build artifacts
build/
target/
dist/
out/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*.pid

# Node.js (if using Node-based tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backup files
*.bak
*.backup
*.old

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# Documentation files (generated from chat)
Jenkins_Pipeline_QA.md